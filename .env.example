# Neon Postgres. Copy this file to .env and paste the real URL.
# Do not commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Chat model. Groq's OpenAI-compatible endpoint.
# 1. Create a key at https://console.groq.com/keys
# 2. Paste it below. Leave the key blank and the app still shows evidence.
# Embeddings stay local. Only the chat model uses this endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_CHAT_MODEL=openai/gpt-oss-120b

# Local Ollama alternative. Comment out the Groq lines above and use these instead.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_CHAT_MODEL=llama3.2
# OPENAI_API_KEY=ollama

# Retrieval. bge writes 384-d vectors into doc_chunks.
# qwen3 writes 1024-d vectors into doc_chunks_qwen3. Do not point both models at one table.
# RERANKER=minilm is the MiniLM cross-encoder. RERANKER=qwen3 scores yes/no logits.
EMBEDDING_MODEL=bge
RERANKER=minilm
